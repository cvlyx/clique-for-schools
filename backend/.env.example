# Copy to .env and fill in real values.
DATABASE_URL=sqlite:///clique.db
# For production use a managed Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
JWT_SECRET=change-me
JWT_MINUTES=720

# Platform admin credentials (created automatically on first startup)
PLATFORM_ADMIN_USERNAME=clique-admin
PLATFORM_ADMIN_PASSWORD=change-me

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8787
